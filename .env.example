# ---- Server-side secrets (set these in Netlify dashboard or local .env) ----
# Firebase Web API key for the BlazeConsole service account.
FIREBASE_API_KEY=
# Email + password of the service account that owns the shared Blaze session.
BLAZE_SERVICE_EMAIL=
BLAZE_SERVICE_PASSWORD=
# Existing chat session ID in the Supabase database used for public requests.
BLAZE_SESSION_ID=

# ---- Optional overrides ----
# Override the upstream Supabase Edge Function URL (defaults to the known deployed value).
# SUPABASE_EDGE_URL=https://eczymonozwinjbzzfwbt.supabase.co/functions/v1/chat
